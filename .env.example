# DevFolio frontend — environment variables
# Copy to .env and adjust to point at your running backend.

# Base URL of the Django REST API (note the /api suffix)
VITE_API_URL=http://127.0.0.1:8000/api

# Origin the backend serves media (avatars, covers) from — used as a fallback
# only; the API already returns absolute media URLs.
VITE_MEDIA_URL=http://127.0.0.1:8000
